{
  "name": "social-autopilot-backend",
  "version": "1.0.0",
  "description": "Production Express.js backend with PostgreSQL/Prisma, Node-Cron task scheduler, OpenAI text generation, and Social Media Publishing APIs (Instagram, LinkedIn, X).",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/unit/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "cron",
    "openai",
    "social-media",
    "instagram",
    "linkedin",
    "x",
    "twitter"
  ],
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.9",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "openai": "^4.85.4",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.0",
    "socket.io-client": "^4.8.3"
  }
