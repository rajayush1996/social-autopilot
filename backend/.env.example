# Server & Environment Setup
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL=debug
OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/callback"

# PostgreSQL Database (Neon.tech / AWS RDS)
DATABASE_URL="postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require"

# Upstash Redis Configuration
REDIS_HOST="concise-crappie-174626.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your_upstash_redis_password"
# REDIS_URL="rediss://default:your_upstash_password@concise-crappie-174626.upstash.io:6379"

# Cryptography & Security Secrets
ENCRYPTION_SECRET_KEY="replace_with_32_character_secure_key_here"
JWT_SECRET="replace_with_secure_jwt_access_secret"
JWT_REFRESH_SECRET="replace_with_secure_jwt_refresh_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OpenAI AI Generation Engine
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_ENABLE_ORGANIZATIONS=false

# X (Twitter) OAuth 2.0 PKCE Credentials
X_CLIENT_ID="your_x_client_id"
X_CLIENT_SECRET="your_x_client_secret"

# Meta (Instagram & Facebook) Credentials
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
INSTAGRAM_SCOPE="instagram_basic,instagram_content_publish,pages_show_list,public_profile"

# Cloudflare R2 Media Storage
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="postpilot"
CLOUDFLARE_R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_PUBLIC_URL="https://media.yourdomain.com"

# Background Queue Strategy Driver ('postgres' for zero-cost native DB queue, 'redis' for BullMQ)
QUEUE_DRIVER="postgres"

# Flux.1 AI Image Generation Setup (Fal.ai / Together AI)
FLUX_API_KEY="your_fal_or_together_api_key_here"
FLUX_PROVIDER="fal"
FLUX_API_URL="https://queue.fal.run/fal-ai/flux/schnell"

