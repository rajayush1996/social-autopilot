// Prisma Schema for Social Media Autopilot Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  X
  FACEBOOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIALLY_PUBLISHED
  CANCELLED
}

enum SocialPostStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AITone {
  PROFESSIONAL
  CASUAL
  ENGAGING
  EDUCATIONAL
  PROMOTIONAL
  HUMOROUS
  STORYTELLING
}

model User {
  id                String            @id @default(uuid())
  uniqueId          String?           @unique
  email             String            @unique
  name              String?
  phoneNumber       String?
  bio               String?
  dateOfBirth       DateTime?
  password          String?
  avatarUrl         String?
  aiCredits         Int               @default(15)
  plan              String            @default("FREE")
  role              String            @default("USER")
  emailVerified     Boolean           @default(false)
  verificationToken String?
  autopilotEnabled  Boolean           @default(false)
  brandContext      String?
  contentSummary    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  notifications     Notification[]
  socialAccounts SocialAccount[]
  posts          Post[]
  aiLogs         AIGenerationLog[]
  automationSchedules AutomationSchedule[]

  @@map("users")
}

model FeatureConfig {
  id        String   @id @default(uuid())
  feature   String   @unique
  isPremium Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_configs")
}

model SocialAccount {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  platformAccountId String
  username          String
  accountName       String?
  accountType       String          @default("PERSONAL")
  avatarUrl         String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  isPremium         Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  socialPostLogs    SocialPostLog[]

  @@unique([userId, platform, platformAccountId])
  @@map("social_accounts")
}

model Post {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  mediaUrls      String[]        @default([])
  mediaType      String?
  targetPlatforms SocialPlatform[]
  status         PostStatus      @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  aiGenerated    Boolean         @default(false)
  aiPrompt       String?
  tone           AITone?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialPostLogs SocialPostLog[]

  @@index([status, scheduledAt])
  @@map("posts")
}

model SocialPostLog {
  id              String           @id @default(uuid())
  postId          String
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  platform        SocialPlatform
  status          SocialPostStatus @default(PENDING)
  externalPostId  String?
  externalPostUrl String?
  errorMessage    String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("social_post_logs")
}

model AIGenerationLog {
  id             String          @id @default(uuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt         String
  targetPlatform SocialPlatform?
  tone           AITone?
  generatedText  String
  modelUsed      String?
  tokensUsed     Int?            @default(0)
  createdAt      DateTime        @default(now())

  @@map("ai_generation_logs")
}

model AutomationSchedule {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String           @default("Daily Auto-Post")
  daysOfWeek      String[]         @default(["MON", "TUE", "WED", "THU", "FRI"])
  draftTimeOfDay  String?          @default("09:00")
  timeOfDay       String           @default("20:00")
  timezone        String           @default("Asia/Kolkata")
  repeatType      String           @default("WEEKLY")
  isActive        Boolean          @default(true)
  targetPlatforms SocialPlatform[] @default([LINKEDIN, X])
  tone            AITone?          @default(ENGAGING)
  topicPrompt     String?
  includeImage    Boolean          @default(false)
  imageMode       String?          @default("NONE") // NONE, AI_FLUX, CUSTOM_UPLOAD
  customImageUrl  String?
  campaignMemory  Json?
  lastDraftAt     DateTime?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, isActive])
  @@map("automation_schedules")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
